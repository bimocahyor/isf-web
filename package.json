{
  "name": "isf-platform",
  "version": "0.0.1",
  "description": "Intelligentsia Scholarship Fund — full-stack platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "db:bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "db:reset-dev-password": "tsx scripts/reset-dev-password.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.13",
    "nunjucks": "^3.2.4",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "*",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "argon2@0.41.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true
  }
}
