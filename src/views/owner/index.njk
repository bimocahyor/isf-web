{% extends "layouts/base.njk" %}

{% block title %}Owner Dashboard — ISF{% endblock %}

{% block body %}
<div class="portal-page">
  <header class="portal-header">
    <a class="brand" href="/" aria-label="Intelligentsia Scholarship Fund home">
      <span class="brand__mark" aria-hidden="true">I</span>
      <span>
        <span class="brand__name">ISF</span>
        <span class="brand__sub">Intelegensia</span>
      </span>
    </a>

    <div class="portal-header__actions">
      <div class="portal-user">
        <span class="portal-user__name">{{ displayName or userEmail }}</span>
        <span class="portal-user__role" style="background:rgba(242,193,78,0.2);color:#F2C14E;border-color:rgba(242,193,78,0.5);">OWNER</span>
      </div>
      <form class="logout-form" method="POST" action="/auth/logout">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <nav class="portal-nav" aria-label="Owner navigation">
    <ul class="portal-nav__list">
      <li><a href="/owner" class="is-active" aria-current="page">Owner Dashboard</a></li>
      <li><a href="/owner/users">User Management</a></li>
      <li><a href="/admin">Admin</a></li>
      <li><a href="/portal">Portal</a></li>
    </ul>
  </nav>

  <main class="portal-main" id="main-content">
    <h1 class="portal-main__heading">Owner Dashboard</h1>
    <p class="portal-main__lead">Governance and system administration for Intelligentsia Scholarship Fund.</p>

    <div class="info-grid">
      <div class="info-card">
        <p class="info-card__label">Signed in as</p>
        <p class="info-card__value">{{ userEmail }}</p>
      </div>
      <div class="info-card">
        <p class="info-card__label">Role</p>
        <p class="info-card__value">OWNER</p>
      </div>
      <div class="info-card">
        <p class="info-card__label">Total users</p>
        <p class="info-card__value">{{ userCount or '—' }}</p>
      </div>
    </div>

    <div style="display:grid; gap:1rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));">
      <a href="/owner/users" style="text-decoration:none;">
        <div class="placeholder-module" style="cursor:pointer; transition: border-color 0.2s; border-color:rgba(242,193,78,0.25);">
          <div class="placeholder-module__icon" aria-hidden="true">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Z"/>
            </svg>
          </div>
          <h2 class="placeholder-module__title">User Management</h2>
          <p class="placeholder-module__desc">List, invite, manage roles, and disable accounts.</p>
        </div>
      </a>

      <div class="placeholder-module">
        <div class="placeholder-module__icon" aria-hidden="true">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z"/>
          </svg>
        </div>
        <h2 class="placeholder-module__title">Audit Log</h2>
        <p class="placeholder-module__desc">Not yet implemented.</p>
      </div>

      <div class="placeholder-module">
        <div class="placeholder-module__icon" aria-hidden="true">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 0 1 1.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.559.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.894.149c-.424.07-.764.383-.929.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 0 1-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 0 1-.12-1.45l.527-.737c.25-.35.272-.806.108-1.204-.165-.397-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.559-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 0 1 .12-1.45l.773-.773a1.125 1.125 0 0 1 1.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
          </svg>
        </div>
        <h2 class="placeholder-module__title">System Configuration</h2>
        <p class="placeholder-module__desc">Not yet implemented.</p>
      </div>
    </div>
  </main>

  <footer class="auth-footer">
    &copy; {{ year }} Intelligentsia Scholarship Fund. All rights reserved.
  </footer>
</div>
{% endblock %}
