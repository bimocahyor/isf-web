{% extends "layouts/base.njk" %}

{% block title %}Reset Password — ISF{% endblock %}

{% block body %}
<div class="auth-page">
  <header class="auth-header">
    <a class="brand" href="/" aria-label="Intelligentsia Scholarship Fund home">
      <span class="brand__mark" aria-hidden="true">I</span>
      <span>
        <span class="brand__name">ISF</span>
        <span class="brand__sub">Intelegensia</span>
      </span>
    </a>
  </header>

  <main class="auth-main" id="main-content">
    <div class="auth-card">
      <p class="auth-card__eyebrow">Set new password</p>
      <h1 class="auth-card__title">Choose a new password</h1>

      {% if tokenError %}
      <div class="alert alert--error" role="alert">{{ tokenError }}</div>
      <div class="auth-links">
        <a href="/auth/forgot-password">Request a new reset link</a>
      </div>
      {% endif %}

      {% if success %}
      <div class="alert alert--success" role="status">
        Your password has been reset successfully. You can now sign in with your new password.
      </div>
      <div class="auth-links">
        <a href="/auth/login">Sign in</a>
      </div>
      {% endif %}

      {% if not tokenError and not success %}
      {% if error %}
      <div class="alert alert--error" role="alert">{{ error }}</div>
      {% endif %}

      <form method="POST" action="/auth/reset-password" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="token" value="{{ token }}">

        <div class="form-group">
          <label class="form-label form-label--required" for="newPassword">New password</label>
          <input
            class="form-input{% if fieldErrors.newPassword %} form-input--error{% endif %}"
            type="password"
            id="newPassword"
            name="newPassword"
            autocomplete="new-password"
            minlength="8"
            maxlength="72"
            required
            aria-describedby="pw-hint{% if fieldErrors.newPassword %} pw-error{% endif %}"
          >
          <p class="form-hint" id="pw-hint">At least 8 characters.</p>
          {% if fieldErrors.newPassword %}
          <p class="form-error" id="pw-error" role="alert">{{ fieldErrors.newPassword }}</p>
          {% endif %}
        </div>

        <button class="btn btn--primary btn--full" type="submit">Set new password</button>
      </form>
      {% endif %}
    </div>
  </main>

  <footer class="auth-footer">
    &copy; {{ year }} Intelligentsia Scholarship Fund. All rights reserved.
  </footer>
</div>
{% endblock %}
