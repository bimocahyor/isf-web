{% extends "layouts/base.njk" %}

{% block title %}Editor Area — ISF{% endblock %}

{% block body %}
<div class="portal-page">
  <header class="portal-header">
    <a class="brand" href="/" aria-label="Intelligentsia Scholarship Fund home">
      <span class="brand__mark" aria-hidden="true">I</span>
      <span>
        <span class="brand__name">ISF</span>
        <span class="brand__sub">Intelegensia</span>
      </span>
    </a>

    <div class="portal-header__actions">
      <div class="portal-user">
        <span class="portal-user__name">{{ displayName or userEmail }}</span>
        <span class="portal-user__role">{{ userRole }}</span>
      </div>
      <form class="logout-form" method="POST" action="/auth/logout">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="btn btn--ghost btn--sm" type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <nav class="portal-nav" aria-label="Admin navigation">
    <ul class="portal-nav__list">
      <li><a href="/portal">Portal</a></li>
      <li><a href="/admin">Admin</a></li>
      <li><a href="/admin/editor" class="is-active" aria-current="page">Editor</a></li>
      {% if userRole == 'ADMIN' or userRole == 'REVIEWER' %}
      <li><a href="/admin/reviewer">Reviewer</a></li>
      {% endif %}
    </ul>
  </nav>

  <main class="portal-main" id="main-content">
    <h1 class="portal-main__heading">Editor Area</h1>
    <p class="portal-main__lead">Create and manage content for the ISF platform.</p>

    <div class="info-grid">
      <div class="info-card">
        <p class="info-card__label">Signed in as</p>
        <p class="info-card__value">{{ userEmail }}</p>
      </div>
      <div class="info-card">
        <p class="info-card__label">Role</p>
        <p class="info-card__value">{{ userRole }}</p>
      </div>
    </div>

    <div class="placeholder-module">
      <div class="placeholder-module__icon" aria-hidden="true">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/>
        </svg>
      </div>
      <h2 class="placeholder-module__title">Content management</h2>
      <p class="placeholder-module__desc">The CMS module is not yet implemented. Check back in a future release.</p>
    </div>
  </main>

  <footer class="auth-footer">
    &copy; {{ year }} Intelligentsia Scholarship Fund. All rights reserved.
  </footer>
</div>
{% endblock %}
